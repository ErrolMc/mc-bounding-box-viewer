{
	"schemaVersion": 1,
	"id": "bounding-box-viewer",
	"version": "${version}",
	"name": "Bounding Box Viewer",
	"description": "Press B to see the bounding boxes of structures in a singleplayer world: witch huts, pillager outposts, ocean monuments, fortresses, end cities, villages and every other structure, with the areas where their own mobs spawn shaded.",
	"authors": [
		"ErrolMc"
	],
	"contact": {
		"sources": "https://github.com/ErrolMc/mc-bounding-box-viewer",
		"issues": "https://github.com/ErrolMc/mc-bounding-box-viewer/issues"
	},
	"license": "MIT",
	"icon": "assets/bounding-box-viewer/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.errolmc.boundingboxviewer.client.BoundingBoxViewerClient"
		],
		"modmenu": [
			"com.errolmc.boundingboxviewer.client.config.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
